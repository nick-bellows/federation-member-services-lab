WEB_APPLICATION_URL=http://localhost:3000
WEBSITE_URL=http://vereinfacht.digital

API_DOMAIN=http://api
API_PATH=/api/v1
API_BEARER_TOKEN=

NEXTAUTH_SECRET=non-production-secret
NEXTAUTH_URL=http://localhost:3000

ADMIN_LOGIN_PATHNAME="/admin/auth/login"

# Federation (fork): OpenID Connect sign-in for /member pages.
# Default = the mock provider from docker-compose.yml (any client id/secret is accepted).
OIDC_ISSUER=http://host.docker.internal:3004/default
OIDC_CLIENT_ID=northgate-web
OIDC_CLIENT_SECRET=northgate-web-secret
OIDC_AUDIENCE=https://api.northgate.example
# Optional Auth0 tenant for the documented walkthrough (leave empty to hide the button).
AUTH0_ISSUER=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

SIGNAL_INVITE_URL=https://google.de
SUPPORT_EMAIL_ADDRESS="hello@vereinfacht.digital"
SUPPORT_PHONE_NUMBER="0461 150653625"
