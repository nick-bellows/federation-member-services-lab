APP_NAME=verein
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3001

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_SLACK_WEBHOOK_URL=

OH_DEAR_HEALTH_CHECK_SECRET=

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=verein
DB_USERNAME=verein
DB_PASSWORD=verein

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
FILAMENT_FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

WEB_APPLICATION_URL=http://localhost:3000
CLUB_ADMIN_LOGIN_PATH=/admin/login

# Federation (fork): OpenID Connect bearer tokens for /api/v1/federation routes.
# Compose default = the mock-oauth2-server service; Auth0 example in config/oidc.php.
OIDC_ISSUER=http://host.docker.internal:3004/default
OIDC_AUDIENCE=https://api.northgate.example
OIDC_JWKS_URI=http://oidc:8080/default/jwks
OIDC_PROVISION_USERS=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Learning Center credentials contract (config/learning_center.php, ADR-0009).

LEARNING_CENTER_BASE_URL=http://learning-center:3005

LEARNING_CENTER_TOKEN_ENDPOINT=http://oidc:8080/default/token

LEARNING_CENTER_CLIENT_ID=federation-api

LEARNING_CENTER_CLIENT_SECRET=dev-only-not-a-secret

LEARNING_CENTER_AUDIENCE=https://learning-center.northgate.example

LEARNING_CENTER_TIMEOUT_MS=800

LEARNING_CENTER_SNAPSHOT_TTL_MINUTES=720
