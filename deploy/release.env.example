# Environment for the release rehearsal (deploy/compose.release.yml).
# Copy to deploy/release.env (gitignored) and set APP_KEY:
#   docker compose exec tooling bash -lc 'cd api && php artisan key:generate --show'
# Every value here is for the rehearsal on a laptop. A deployment supplies
# these from its secret store (docs/DEPLOYMENT.md); none is a real secret.

APP_NAME="Northgate Federation"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:3011

LOG_CHANNEL=json
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=verein
DB_USERNAME=verein
DB_PASSWORD=release-rehearsal

CACHE_DRIVER=file
FILESYSTEM_DISK=local
FILAMENT_FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@northgate.example
MAIL_FROM_NAME="Northgate Federation"

WEB_APPLICATION_URL=http://localhost:3010
CLUB_ADMIN_LOGIN_PATH=/admin/auth/login

# Identity: the browser and the API must agree on the issuer string.
OIDC_ISSUER=http://host.docker.internal:3014/default
OIDC_AUDIENCE=https://api.northgate.example
OIDC_JWKS_URI=http://oidc:8080/default/jwks
OIDC_PROVISION_USERS=true

# Learning Center (mock in the rehearsal)
LEARNING_CENTER_BASE_URL=http://learning-center:3005
LEARNING_CENTER_TOKEN_ENDPOINT=http://oidc:8080/default/token
LEARNING_CENTER_CLIENT_ID=federation-api
LEARNING_CENTER_CLIENT_SECRET=release-rehearsal-only
LEARNING_CENTER_AUDIENCE=https://learning-center.northgate.example
LEARNING_CENTER_TIMEOUT_MS=1500
LEARNING_CENTER_SNAPSHOT_TTL_MINUTES=720

# Observability
OTEL_EXPORTER=none
OTEL_SERVICE_NAME=federation-api
READINESS_OUTBOX_MAX_AGE_SECONDS=300
METRICS_TOKEN=release-rehearsal-scrape-token
